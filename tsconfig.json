{
  "extends": "@tsconfig/node24/tsconfig.json",
  "_version": "24.0.0",

  "compilerOptions": {
    "lib": ["es2023"],
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2023",
    
    "allowJs": true,
    "declaration": true,
    "emitDecoratorMetadata": false,
    "esModuleInterop": true,
    "experimentalDecorators": false,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "outDir": "dist",
    "skipLibCheck": true,
    "strict": true
  },

  "exclude": ["examples"],
  "include": ["src/**/*", "test/**/*", "test/data/basic/v1", "test/data/basic/AbstractCollectionResource.ts", "test/data/basic/AbstractSingleResource.ts", "test/data/basic/openapi.ts"]
}